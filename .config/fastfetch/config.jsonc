{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"source": "auto",
		"padding": {
			"top": 2
		},
		"color": {
			"1": "black",
			"2": "red",
			"3": "black",
			"4": "red",
			"5": "black",
			"6": "red"
		}
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"type": "custom",
			"format": "",
			"key": "╭──────────────────╮"
		},
		{
			"type": "title",
			"key": "│   user          │",
			"keyColor": "red"
		},
		{
			"type": "custom",
			"format": "",
			"key": "├──────────────────┤"
		},
		{
			"type": "os",
			"key": "│   os            │",
			"keyColor": "blue"
		},
		{
			"type": "host",
			"key": "│ 󰌢  host          │",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": "│   kernel        │",
			"keyColor": "red"
		},
		{
			"type": "uptime",
			"key": "│ 󰅐  uptime        │",
			"keyColor": "yellow"
		},
		{
			"type": "packages",
			"key": "│ 󰏖  packages      │",
			"keyColor": "yellow"
		},
		{
			"type": "shell",
			"key": "│   shell         │",
			"keyColor": "magenta"
		},
		{
			"type": "display",
			"key": "│ 󰍹  display       │",
			"keyColor": "green"
		},
		{
			"type": "wm",
			"key": "│   wm            │",
			"keyColor": "green"
		},
		{
			"type": "wmtheme",
			"key": "│   wm theme      │",
			"keyColor": "green"
		},
		{
			"type": "theme",
			"key": "│  theme          │",
			"keyColor": "cyan"
		},
		{
			"type": "icons",
			"key": "│ 󰀻  icons         │",
			"keyColor": "cyan"
		},
		{
			"type": "font",
			"key": "│   font          │",
			"keyColor": "cyan"
		},
		{
			"type": "terminal",
			"key": "│   terminal      │",
			"keyColor": "magenta"
		},
		{
			"type": "cpu",
			"key": "│   cpu           │",
			"keyColor": "red"
		},
		{
			"type": "gpu",
			"key": "│ 󰢮  gpu           │",
			"keyColor": "red"
		},
		{
			"type": "memory",
			"key": "│ 󰍛  memory        │",
			"keyColor": "green"
		},
		{
			"type": "swap",
			"key": "│ 󰓡  swap          │",
			"keyColor": "green"
		},
		{
			"type": "disk",
			"key": "│   disk          │",
			"keyColor": "green"
		},
		{
			"type": "localip",
			"key": "│ 󰩠  local ip      │",
			"keyColor": "blue"
