		{
			"type": "custom",
			"format": "",
			"key": "├──────────────────┤"
		},
		{
			"type": "colors",
			"key": "│   colors        │",
			"keyColor": "magenta",
			"symbol": "circle"
		},
		{
			"type": "custom",
			"format": "",
